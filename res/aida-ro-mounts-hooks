#!/bin/ash

run_latehook() {
    local rootarg rootuuid rootdev rootflags subvol snapshot_id
    local snapmount lowerdir upperdir workdir targetdir proceed
    
    proceed=1

    rootarg=$(getarg root)
    if [ -z "$rootarg" ]; then
        echo "etc-overlay: undefined root=[$rootarg]" >/dev/console
        proceed=0
    fi

    rootflags=$(getarg rootflags)
    if [ -z "$rootflags" ]; then
        echo "etc-overlay: undefined rootflags=[$rootflags]" >/dev/console
        proceed=0
    fi
        
    subvol=${rootflags#*subvol=}
    subvol=${subvol%%,*}
    if [ -z "$subvol" ]; then
        echo "etc-overlay: undefined root subvolume: $subvol" >/dev/console
        proceed=0
    fi    
    
    snapshot_id=${subvol#@snapshots/}
    snapshot_id=${snapshot_id%/snapshot}
    if [ -z "$snapshot_id" ]; then
       echo "etc-overlay: snapshot_id=[$snapshot_id]" >/dev/console
       proceed=0
    fi
    
    rootuuid=${rootarg#UUID=}
    if [ -z "$rootuuid" ]; then
        echo "etc-overlay: undefined root=UUID=$rootuuid" >/dev/console
        proceed=0
    fi
    
    rootdev=$(blkid -U "$rootuuid")
    if [ -z "$rootdev" ]; then
        echo "etc-overlay: undefined root device $rootdev" >/dev/console
        proceed=0
    fi    
    
    sysroot="/sysroot"
    snapmount="$sysroot/.snapshots"
    lowerdir="$sysroot/.snapshots/$snapshot_id/snapshot/etc"
    upperdir="$sysroot/.snapshots/$snapshot_id/overlay/etc"
    workdir="$sysroot/.snapshots/$snapshot_id/workdir/etc"
    targetdir="$sysroot/etc"

    if [ $proceed -eq 1 ]; then
        mount -o remount,ro "$sysroot/"
        mount -t btrfs -o subvol=@snapshots,defaults,noatime,compress=lzo "$rootdev" "$snapmount"
        mount -t overlay overlay -o "lowerdir=$lowerdir,upperdir=$upperdir,workdir=$workdir" "$targetdir"
    else
        echo "Cannot mount /@snapshots on /.snapshots"
        echo "Cannot overlay /etc"
        echo "Cannot switch to read-only root file system"
    fi
}
